{
  "id": "backend-challenge",
  "realm": "backend-challenge",
  "displayName": "Backend Challenge Go - Dev Realm",
  "enabled": true,
  "sslRequired": "none",
  "registrationAllowed": false,
  "loginWithEmailAllowed": true,
  "duplicateEmailsAllowed": false,
  "resetPasswordAllowed": false,
  "editUsernameAllowed": false,
  "bruteForceProtected": true,
  "accessTokenLifespan": 300,
  "accessTokenLifespanForImplicitFlow": 300,
  "ssoSessionIdleTimeout": 1800,
  "ssoSessionMaxLifespan": 36000,
  "roles": {
    "realm": [
      {
        "name": "provider",
        "description": "Identidade de um provedor externo de apostas (ex.: provider-a, provider-b). A claim provider_id do token determina quais transacoes esse principal pode acessar; um provedor nunca enxerga transacoes de outro."
      },
      {
        "name": "internal-service",
        "description": "Identidade de um servico interno confiavel (ex.: wallet-service). Autoriza operacoes de carteira restritas ao backend (abertura de carteira, reconciliacao), nunca expostas a provedores externos."
      }
    ]
  },
  "clients": [
    {
      "clientId": "provider-a",
      "name": "Provider A (external wagering provider)",
      "description": "Client client_credentials de um provedor externo de apostas de exemplo. O access token carrega a claim provider_id=provider-a, usada pela API para autorizar o acesso somente as proprias transacoes (inclusive em replay).",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": false,
      "bearerOnly": false,
      "standardFlowEnabled": false,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": true,
      "authorizationServicesEnabled": false,
      "clientAuthenticatorType": "client-secret",
      "secret": "provider-a-local-dev-secret",
      "redirectUris": [],
      "webOrigins": [],
      "fullScopeAllowed": false,
      "protocolMappers": [
        {
          "name": "provider-id",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-hardcoded-claim-mapper",
          "consentRequired": false,
          "config": {
            "claim.name": "provider_id",
            "claim.value": "provider-a",
            "jsonType.label": "String",
            "id.token.claim": "true",
            "access.token.claim": "true",
            "userinfo.token.claim": "true"
          }
        }
      ]
    },
    {
      "clientId": "provider-b",
      "name": "Provider B (external wagering provider)",
      "description": "Segundo client client_credentials de provedor externo (provider_id=provider-b), usado nos testes de isolamento entre provedores: provider-a nao deve conseguir ler/replayar transacoes de provider-b e vice-versa.",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": false,
      "bearerOnly": false,
      "standardFlowEnabled": false,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": true,
      "authorizationServicesEnabled": false,
      "clientAuthenticatorType": "client-secret",
      "secret": "provider-b-local-dev-secret",
      "redirectUris": [],
      "webOrigins": [],
      "fullScopeAllowed": false,
      "protocolMappers": [
        {
          "name": "provider-id",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-hardcoded-claim-mapper",
          "consentRequired": false,
          "config": {
            "claim.name": "provider_id",
            "claim.value": "provider-b",
            "jsonType.label": "String",
            "id.token.claim": "true",
            "access.token.claim": "true",
            "userinfo.token.claim": "true"
          }
        }
      ]
    },
    {
      "clientId": "wallet-service",
      "name": "Wallet Service (internal)",
      "description": "Client interno (client_credentials) para operacoes de carteira restritas ao backend. directAccessGrantsEnabled habilitado so para obter token via Resource Owner Password Credentials em dev, com o usuario de teste do realm.",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": false,
      "bearerOnly": false,
      "standardFlowEnabled": false,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": true,
      "serviceAccountsEnabled": true,
      "authorizationServicesEnabled": false,
      "clientAuthenticatorType": "client-secret",
      "secret": "wallet-service-local-dev-secret",
      "redirectUris": [],
      "webOrigins": [],
      "fullScopeAllowed": false,
      "protocolMappers": [
        {
          "name": "service-name",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-hardcoded-claim-mapper",
          "consentRequired": false,
          "config": {
            "claim.name": "service_name",
            "claim.value": "wallet-service",
            "jsonType.label": "String",
            "id.token.claim": "true",
            "access.token.claim": "true",
            "userinfo.token.claim": "true"
          }
        }
      ]
    }
  ],
  "users": [
    {
      "username": "service-account-provider-a",
      "enabled": true,
      "serviceAccountClientId": "provider-a",
      "realmRoles": ["provider"]
    },
    {
      "username": "service-account-provider-b",
      "enabled": true,
      "serviceAccountClientId": "provider-b",
      "realmRoles": ["provider"]
    },
    {
      "username": "service-account-wallet-service",
      "enabled": true,
      "serviceAccountClientId": "wallet-service",
      "realmRoles": ["internal-service"]
    },
    {
      "username": "testuser",
      "enabled": true,
      "emailVerified": true,
      "email": "testuser@example.com",
      "firstName": "Test",
      "lastName": "User",
      "credentials": [
        {
          "type": "password",
          "value": "testpassword",
          "temporary": false
        }
      ],
      "realmRoles": ["provider"]
    }
  ]
}
