# =============================================================================
# backend-challenge-go — variaveis de ambiente de exemplo
#
# Copie este arquivo para ".env" na raiz do projeto e ajuste se necessario.
# NENHUM valor aqui e um segredo real: as credenciais de Postgres/Keycloak/
# LocalStack abaixo existem apenas no ambiente de desenvolvimento local
# definido em deployments/docker-compose.yml (ver tambem
# deployments/keycloak/realm-export.json) e nunca devem ser reaproveitadas
# em um ambiente real.
# =============================================================================

# --- Aplicacao ---------------------------------------------------------------
APP_ENV=development
HTTP_PORT=8080
METRICS_PORT=9090
LOG_LEVEL=info
SHUTDOWN_TIMEOUT=25s

# --- Postgres ------------------------------------------------------------
POSTGRES_HOST=localhost
# 5433 em vez do default 5432 para nao colidir com outro Postgres local que
# ja esteja rodando na maquina de desenvolvimento; ajuste se preciso.
POSTGRES_PORT=5433
POSTGRES_USER=wallet
POSTGRES_PASSWORD=wallet
POSTGRES_DB=backend_challenge

# Usada diretamente pela aplicacao (pgxpool) e pela CLI golang-migrate:
#   migrate -database $DATABASE_URL -path migrations up
DATABASE_URL=postgres://wallet:wallet@localhost:5433/backend_challenge?sslmode=disable
DB_MAX_CONNS=10
DB_MIN_CONNS=2

# --- AWS / LocalStack (SQS) ------------------------------------------------
AWS_REGION=us-east-1
# Endpoint customizado do LocalStack; o client aws-sdk-go-v2 deve usar isto
# via EndpointResolverV2/BaseEndpoint em vez do endpoint publico da AWS.
AWS_SQS_ENDPOINT=http://localhost:4566
# Credenciais fake exigidas pelo SDK mesmo contra o LocalStack.
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test

# Fila de entrada: API publica (fluxo assincrono) e worker SQS consome.
SQS_WAGER_TRANSACTIONS_QUEUE_NAME=wager-transactions.fifo
SQS_WAGER_TRANSACTIONS_QUEUE_URL=http://localhost:4566/000000000000/wager-transactions.fifo
SQS_WAGER_TRANSACTIONS_DLQ_NAME=wager-transactions-dlq.fifo
SQS_WAGER_TRANSACTIONS_DLQ_URL=http://localhost:4566/000000000000/wager-transactions-dlq.fifo

# Fila de saida: outbox publisher publica os eventos de dominio.
SQS_WAGER_EVENTS_QUEUE_NAME=wager-events.fifo
SQS_WAGER_EVENTS_QUEUE_URL=http://localhost:4566/000000000000/wager-events.fifo
SQS_WAGER_EVENTS_DLQ_NAME=wager-events-dlq.fifo
SQS_WAGER_EVENTS_DLQ_URL=http://localhost:4566/000000000000/wager-events-dlq.fifo

# Parametros do consumidor SQS (internal/adapters/sqs/consumer.go)
SQS_CONSUMER_NAME=wager-transactions-consumer
SQS_MAX_MESSAGES=10
SQS_WAIT_TIME_SECONDS=20
SQS_VISIBILITY_TIMEOUT=30

# --- OIDC / Keycloak ---------------------------------------------------------
KEYCLOAK_PORT=8081
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=admin
KEYCLOAK_REALM=backend-challenge
# Issuer validado pelo go-oidc (deve bater exatamente com o campo "iss" dos
# tokens emitidos pelo Keycloak — ver KC_HOSTNAME* em docker-compose.yml).
OIDC_ISSUER_URL=http://localhost:8081/realms/backend-challenge

# Client interno usado pela propria aplicacao (client_credentials) para
# operacoes de carteira restritas ao backend.
OIDC_CLIENT_ID=wallet-service
OIDC_CLIENT_SECRET=wallet-service-local-dev-secret

# Clients de exemplo (client_credentials) representando provedores
# externos; usados em testes manuais/integracao para simular chamadas de
# provider-a/provider-b, nunca pela propria aplicacao.
PROVIDER_A_CLIENT_ID=provider-a
PROVIDER_A_CLIENT_SECRET=provider-a-local-dev-secret
PROVIDER_B_CLIENT_ID=provider-b
PROVIDER_B_CLIENT_SECRET=provider-b-local-dev-secret

# Usuario de teste provisionado no realm (ver
# deployments/keycloak/realm-export.json), util para obter um token manual
# via Resource Owner Password Credentials contra o client wallet-service.
OIDC_TEST_USERNAME=testuser
OIDC_TEST_PASSWORD=testpassword

# --- Worker de PENDING_REFERENCE (internal/workers/pending_reference_resolver.go) ---
# Backoff exponencial com jitter; nunca fixos no codigo (ver ARCHITECTURE.md).
# Nomes abaixo devem bater exatamente com internal/config/config.go (Load).
PENDING_REFERENCE_BACKOFF_BASE=2s
PENDING_REFERENCE_BACKOFF_FACTOR=2.0
PENDING_REFERENCE_BACKOFF_MAX_INTERVAL=5m
# Fracao (0-1), nao percentual: 0.2 = +/-20%.
PENDING_REFERENCE_BACKOFF_JITTER=0.2
PENDING_REFERENCE_MAX_ATTEMPTS=10
PENDING_REFERENCE_TTL=30m
# Intervalo de poll do worker (SELECT ... FOR UPDATE SKIP LOCKED); dobra ate
# o teto abaixo quando o lote vem vazio, para evitar hot-loop em idle.
PENDING_REFERENCE_POLL_INTERVAL=2s
PENDING_REFERENCE_MAX_POLL_INTERVAL=10s
PENDING_REFERENCE_BATCH_SIZE=50

# --- Outbox publisher (internal/workers/outbox_publisher.go) ----------------
OUTBOX_BACKOFF_BASE=2s
OUTBOX_BACKOFF_FACTOR=2.0
OUTBOX_BACKOFF_MAX_INTERVAL=5m
OUTBOX_BACKOFF_JITTER=0.2
OUTBOX_POLL_INTERVAL=2s
OUTBOX_MAX_POLL_INTERVAL=10s
OUTBOX_BATCH_SIZE=100

